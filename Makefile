CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra -std=c89 -pedantic
SRC = MAIN.C FILEIO.C ERROR.C CONVERT.C RECOVERY.C REGISTRY.C TEST.C TABLES/TABLES.C TABLES/FWD00.C TABLES/FWD01.C TABLES/FWD02.C TABLES/FWD03.C TABLES/FWD04.C TABLES/FWD05.C TABLES/FWD06.C TABLES/FWD07.C TABLES/FWD08.C TABLES/FWD09.C TABLES/FWD10.C TABLES/FWD11.C TABLES/FWD12.C TABLES/FWD13.C TABLES/FWD14.C TABLES/FWD15.C TABLES/FWD16.C TABLES/REV00.C TABLES/REV01.C TABLES/REV02.C TABLES/REV03.C TABLES/REV04.C TABLES/REV05.C TABLES/REV06.C TABLES/REV07.C TABLES/REV08.C TABLES/REV09.C TABLES/REV10.C TABLES/REV11.C TABLES/REV12.C TABLES/REV13.C TABLES/REV14.C TABLES/REV15.C TABLES/REV16.C FROM/UTF8.C FROM/UTF16.C FROM/CP949.C FROM/CP437.C FROM/CP1252.C TO/UTF8.C TO/UTF16.C TO/CP949.C TO/CP437.C TO/CP1252.C
OBJ = $(SRC:.C=.o)
all: EncodingTool
.PHONY: all clean
EncodingTool: $(OBJ)
	$(CC) $(CFLAGS) -o $@ $(OBJ)
FILEIO.o CONVERT.o RECOVERY.o: FILEIO.H CODEC.H
MAIN.o: ERROR.H
MAIN.o CONVERT.o RECOVERY.o TEST.o: CONVERT.H
ERROR.o CONVERT.o RECOVERY.o: ERROR.H
%.o: %.C CODEC.H
	$(CC) $(CFLAGS) -x c -c $< -o $@
clean:
	rm -f $(OBJ) EncodingTool
